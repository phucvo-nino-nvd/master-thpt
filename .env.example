CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACT_MODEL=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_CANONICAL_MODEL=deepseek/deepseek-v3.2
OPENROUTER_TEACHER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_AUTHOR_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VERIFIER_MODEL=google/gemini-2.5-flash
OPENROUTER_LEARNER_MODEL=typesafe/jev-1.13

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="master"

NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

CRAWLER_TIMEOUT=15
CRAWLER_MAX_PAGES=15
CRAWL_TOP_K=1
CRAWL_NODES=2
CRAWL_GRADES=10,11,12

MAX_GRADING_WORKERS=8
VERIFIER_TOOL_TURNS=2
ERROR_CONFIDENCE_THRESHOLD=0.65
RECENT_ERROR_DAYS=14
TYPE_GAP_THRESHOLD=0.15
SYMPY_MAX_LENGTH=200
SYMPY_DIGITS=6
TAGGER_BATCH_SIZE=8
TAGGER_MIN_ALIAS_LENGTH=6

MASTERY_INITIAL=0.5
MASTERY_CORRECT_RATE=0.20
MASTERY_INCORRECT_RATE=0.25
WEAK_THRESHOLD=0.50
MASTERED_THRESHOLD=0.80
PRACTICE_CARD_LIMIT=10
PRACTICE_DURATION=0
PRACTICE_MIN_QUESTIONS=6
REVIEW_INTERVAL_DAYS=7
REVIEW_DAILY_LIMIT=20
REVIEW_RETENTION=0.9
STATION_QUESTIONS=6
STAGE_QUESTIONS=10
PLACEMENT_QUESTIONS=2
STATION_PASS_RATE=0.8
OBSTACLE_DEPTH=3
OBSTACLE_QUESTIONS=6
