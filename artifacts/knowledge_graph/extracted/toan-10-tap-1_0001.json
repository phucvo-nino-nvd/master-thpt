      "grade": 10
    },
    {
      "id": "MENH_DE_DAO",
      "name": "Mệnh đề đảo",
      "type": "CONCEPT",
      "description": "Mệnh đề đảo của mệnh đề P ⇒ Q là Q ⇒ P.",
      "grade": 10
    },
    {
      "id": "MENH_DE_TUONG_DUONG",
      "name": "Mệnh đề tương đương",
      "type": "CONCEPT",
