{
  "chunk_id": "toan-11-tap-1:0003",
  "nodes": [
    {
      "id": "HAM_SO_SIN",
      "name": "Hàm số sin",
      "type": "CONCEPT",
      "description": "Quy tắc đặt tương ứng mỗi số thực x với số thực sin x, kí hiệu y = sin x. Tập xác định là ℝ.",
      "grade": 11
    },
    {
      "id": "HAM_SO_COS",
      "name": "Hàm số cos",
      "type": "CONCEPT",
      "description": "Quy tắc đặt tương ứng mỗi số thực x với số thực cos x, kí hiệu y = cos x. Tập xác định là ℝ.",
      "grade": 11
    },
    {
      "id": "HAM_SO_TAN",
      "name": "Hàm số tang",
      "type": "CONCEPT",
      "description": "Hàm số cho bằng công thức y = sin x / cos x, kí hiệu y = tan x. Tập xác định là ℝ  {π/2 + kπ | k ∈ ℤ}.",
      "grade": 11
    },
    {
      "id": "HAM_SO_COT",
      "name": "Hàm số cotang",
      "type": "CONCEPT",
      "description": "Hàm số cho bằng công thức y = cos x / sin x, kí hiệu y = cot x. Tập xác định là ℝ  {kπ | k ∈ ℤ}.",
      "grade": 11
    },
    {
      "id": "HAM_SO_CHAN",
      "name": "Hàm số chẵn",
      "type": "CONCEPT",
      "description": "Hàm số f(x) được gọi là chẵn nếu ∀x ∈ D thì -x ∈ D và f(-x) = f(x). Đồ thị nhận trục tung là trục đối xứng.",
      "grade": 11
    },
    {
      "id": "HAM_SO_LE",
      "name": "Hàm số lẻ",
      "type": "CONCEPT",
      "description": "Hàm số f(x) được gọi là lẻ nếu ∀x ∈ D thì -x ∈ D và f(-x) = -f(x). Đồ thị nhận gốc tọa độ là tâm đối xứng.",
      "grade": 11
    },
    {
      "id": "HAM_SO_TUAN_HOAN",
      "name": "Hàm số tuần hoàn",
      "type": "CONCEPT",
      "description": "Hàm số f(x) được gọi là tuần hoàn nếu tồn tại số T ≠ 0 sao cho với mọi x ∈ D, x + T ∈ D, x - T ∈ D và f(x + T) = f(x).",
      "grade": 11
    },
    {
      "id": "CHU_KI",
      "name": "Chu kì",
      "type": "CONCEPT",
      "description": "Số T dương nhỏ nhất thỏa mãn các điều kiện của hàm số tuần hoàn (nếu có).",
      "grade": 11
    },
    {
      "id": "DO_THI_HAM_SO",
      "name": "Đồ thị hàm số",
      "type": "CONCEPT",
      "description": "Biểu diễn hình học của một hàm số trên hệ tọa độ Oxy.",
      "grade": 11
    },
    {
      "id": "TAP_GIA_TRI",
      "name": "Tập giá trị",
      "type": "CONCEPT",
      "description": "Tập tất cả các giá trị mà hàm số có thể nhận.",
      "grade": 11
    },
    {
      "id": "KHOANG_DONG_BIEN",
      "name": "Khoảng đồng biến",
      "type": "CONCEPT",
      "description": "Khoảng trong đó hàm số tăng dần.",
      "grade": 11
    },
    {
      "id": "KHOANG_NGHICH_BIEN",
      "name": "Khoảng nghịch biến",
      "type": "CONCEPT",
      "description": "Khoảng trong đó hàm số giảm dần.",
      "grade": 11
    },
    {
      "id": "DUONG_HINH_SIN",
      "name": "Đường hình sin",
      "type": "CONCEPT",
      "description": "Đồ thị của hàm số y = sin x.",
      "grade": 11
    },
    {
      "id": "DUONG_HINH_COS",
      "name": "Đường hình cos",
      "type": "CONCEPT",
      "description": "Đồ thị của hàm số y = cos x.",
      "grade": 11
    },
    {
      "id": "DUONG_HINH_TAN",
      "name": "Đường hình tan",
      "type": "CONCEPT",
      "description": "Đồ thị của hàm số y = tan x.",
      "grade": 11
    },
    {
      "id": "DUONG_HINH_COT",
      "name": "Đường hình cot",
      "type": "CONCEPT",
      "description": "Đồ thị của hàm số y = cot x.",
      "grade": 11
    },
    {
      "id": "TINH_CHAT_HAM_SO",
      "name": "Tính chất hàm số",
      "type": "CONCEPT",
      "description": "Các đặc điểm của hàm số như chẵn, lẻ, tuần hoàn, đồng biến, nghịch biến.",
      "grade": 11
    },
    {
      "id": "PHUONG_TRINH_DAO_DONG",
      "name": "Phương trình dao động điều hoà",
      "type": "CONCEPT",
      "description": "Phương trình tổng quát của một vật dao động điều hoà: x(t) = A cos(ωt + φ).",
      "grade": 11
    },
    {
      "id": "BIEN_DO_DAO_DONG",
      "name": "Biên độ dao động",
      "type": "CONCEPT",
      "description": "A trong phương trình dao động điều hoà, biểu thị độ lớn của dao động.",
      "grade": 11
    },
    {
      "id": "PHA_DAO_DONG",
      "name": "Pha dao động",
      "type": "CONCEPT",
      "description": "ωt + φ trong phương trình dao động điều hoà, biểu thị trạng thái của dao động tại thời điểm t.",
      "grade": 11
    },
    {
      "id": "PHA_BAN_DAU",
      "name": "Pha ban đầu",
      "type": "CONCEPT",
      "description": "φ trong phương trình dao động điều hoà, biểu thị pha của dao động tại thời điểm ban đầu.",
      "grade": 11
    },
    {
      "id": "CHU_KI_DAO_DONG",
      "name": "Chu kì dao động",
      "type": "CONCEPT",
      "description": "Khoảng thời gian để vật thực hiện một dao động toàn phần, T = 2π/ω.",
      "grade": 11
    }
  ],
